{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter claude-warriors build && pnpm --filter server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter server start",
    "preDeployCommand": "pnpm --filter server db:migrate",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
