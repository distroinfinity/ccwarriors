# ─── CCWarriors API (apps/server) ───────────────────────────────────────────

# HTTP port. Railway sets this automatically in production.
PORT=8080

# Postgres connection string.
#  • PRODUCTION: set to your Railway Postgres URL.
#  • LOCAL: leave UNSET to use an in-memory PGlite database (zero setup).
DATABASE_URL=

# Demo data — LOCAL ONLY. Never set these in production.
#   SEED_DEMO=true  seeds 15 fake warriors so the board isn't empty.
#   SIMULATE=true   bumps a random warrior's spend every ~2.5s (live reordering).
SEED_DEMO=false
SIMULATE=false

# Allowed browser origin(s) for the public API. "*" or comma-separated list.
# PRODUCTION: https://ccwarriors.xyz
CORS_ORIGIN=*

# ─── GitHub OAuth (real enlistment: web login + CLI) ─────────────────────────
# Create an OAuth app at https://github.com/settings/applications/new
# Authorization callback URL must be:  <PUBLIC_BASE_URL>/cli/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL where THIS API is reachable (used to build OAuth callback URLs).
#  • PRODUCTION: https://api.ccwarriors.xyz
#  • LOCAL:      http://localhost:8787
PUBLIC_BASE_URL=http://localhost:8787

# Public URL of the web app (where users get redirected after web login).
#  • PRODUCTION: https://ccwarriors.xyz
#  • LOCAL:      http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# ─── Razorpay donations (the #sponsor section) ───────────────────────────────
# Standard Web Checkout keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Donations are disabled (POST /donate/* absent) when unset.
#  • LOCAL: rzp_test_* keys (test mode)
#  • PRODUCTION: rzp_live_* keys (Railway env vars)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set when creating the payment.captured webhook in the
# dashboard (Account & Settings → Webhooks → URL: <PUBLIC_BASE_URL>/donate/webhook).
# Catches donors whose tab closed before the browser verify call. Optional;
# the webhook route is absent when unset.
RAZORPAY_WEBHOOK_SECRET=

# ─── Discord OAuth (org membership verification, e.g. Network School) ────────
# Create an app at https://discord.com/developers/applications
# OAuth2 redirect must be:  <PUBLIC_BASE_URL>/discord/callback
# Scopes used at runtime: identify, guilds. Unset = org verification disabled.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Per-org Discord server IDs (right-click the server with Developer Mode on).
# NS = Network School (ns.ccwarriors.xyz).
NS_GUILD_ID=

# ─── OpenTelemetry ──────────────────────────────────────────────────────────
# Standard OTel env vars, no custom config. Unset OTEL_EXPORTER_OTLP_ENDPOINT
# and nothing is exported: the SDK loads, finds no destination and stays quiet,
# so local dev and CI need no extra flags.
# PRODUCTION: set these on the Railway api service.
#
# Any OTLP backend works. These values are for hosted sigiro, which terminates
# OTLP/HTTP on 443, NOT the conventional :4318. A self-hosted collector keeps
# its usual port, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ccwarriors-server
# The cloud detectors do not apply on Railway, and the GCP one stalls boot
# probing a metadata server that is not there.
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
