# ─── CCWarriors web (apps/web) ───────────────────────────────────────────────
# WebSocket URL of the backend API.
#   LOCAL:      ws://localhost:8787
#   PRODUCTION: wss://api.ccwarriors.xyz   (set in Vercel project env vars)
VITE_WS_URL=ws://localhost:8787

# Self-custody wallets for the crypto donation tab. A chain hides when its
# address is unset; the whole tab hides when both are.
#   PRODUCTION: set in Vercel project env vars
VITE_EVM_ADDRESS=
VITE_SOL_ADDRESS=
